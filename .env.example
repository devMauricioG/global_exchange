# Configuración de Django
SECRET_KEY=django-insecure-local-dev-key-change-in-prod
DEBUG=True

# Base de datos (Django)
DB_NAME=global_exchange_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Base de datos (Keycloak)
KEYCLOAK_DB_NAME=keycloak_db

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=GlobalExchangeRealm
KEYCLOAK_CLIENT_ID=django-app
KEYCLOAK_CLIENT_SECRET=tu-secret-local

# OIDC (mozilla-django-oidc)
OIDC_RP_SIGN_ALGO=RS256

# Servidor SMTP (Mailpit en desarrollo)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025

# Pasarela de Pagos Stripe (SCRUM-92)
STRIPE_PUBLIC_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
STRIPE_CURRENCY=usd